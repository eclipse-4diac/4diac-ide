<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="RT_E_CYCLE" Comment="Periodic event generator">
	<Identification Description="Copyright (c) 2008 ACIN&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0&#10;&#10;Periodic event source: fires EO every DT starting from START until STOP. EO runs in a dedicated RT thread whose priority is derived from Deadline and WCET. Use only when real-time scheduling of the cyclic event chain is required.">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="3.1" Author="Franz Höpfinger" Date="2026-05-14" Remarks="Extended Documentation">
	</VersionInfo>
	<VersionInfo Version="3.0" Author="Patrick Aigner" Date="2025-04-14" Remarks="changed package">
	</VersionInfo>
	<VersionInfo Organization="ACIN" Version="1.0" Author="Alois Zoitl" Date="2008-07-10">
	</VersionInfo>
	<CompilerInfo packageName="eclipse4diac::rtevents">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="START" Type="Event" Comment="Start the periodic timer with the current DT; ignored if already running">
				<With Var="DT"/>
				<With Var="Deadline"/>
				<With Var="WCET"/>
			</Event>
			<Event Name="STOP" Type="Event" Comment="Stop the periodic timer; no further EO events will be fired">
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="EO" Type="Event" Comment="Periodic output event: fired every DT in a dedicated RT thread">
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="DT" Type="TIME" Comment="Period between consecutive EO events"/>
			<VarDeclaration Name="Deadline" Type="TIME" Comment="Relative deadline by which all processing triggered by EO must complete; must be greater than WCET"/>
			<VarDeclaration Name="WCET" Type="TIME" Comment="Worst-case execution time of the entire event chain triggered by EO (not just this block); used for EO thread priority calculation"/>
		</InputVars>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
