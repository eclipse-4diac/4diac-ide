<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="RT_E_TRAIN" Comment="Finite event train generator">
	<Identification Description="Copyright (c) 2008 ACIN&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0&#10;&#10;Fires EO exactly N times at period DT, starting DT after START. CV holds the current event index (0 to N-1). Stops automatically after N firings or on STOP. Implemented internally as RT_E_CYCLE + E_CTU + E_SWITCH.">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="3.1" Author="Franz Höpfinger" Date="2026-05-14" Remarks="Extended Documentation">
	</VersionInfo>
	<VersionInfo Version="3.0" Author="Patrick Aigner" Date="2025-04-14" Remarks="changed package">
	</VersionInfo>
	<VersionInfo Organization="ACIN" Version="1.0" Author="Alois Zoitl" Date="2008-07-10">
	</VersionInfo>
	<CompilerInfo packageName="eclipse4diac::rtevents">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="START" Type="Event" Comment="Start generating the event train with the current DT and N; resets the counter and begins firing EO after the first DT">
				<With Var="DT"/>
				<With Var="N"/>
				<With Var="Deadline"/>
				<With Var="WCET"/>
			</Event>
			<Event Name="STOP" Type="Event" Comment="Stop the event train immediately; no further EO events will be fired">
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="EO" Type="Event" Comment="Periodic output event: fired N times at period DT, starting at DT after START; CV holds the current index (0 to N-1)">
				<With Var="CV"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="DT" Type="TIME" Comment="Period between consecutive EO events"/>
			<VarDeclaration Name="N" Type="UINT" Comment="Total number of EO events to generate; train stops automatically after N firings"/>
			<VarDeclaration Name="Deadline" Type="TIME" Comment="Relative deadline by which all processing triggered by EO must complete (must be greater than WCET)"/>
			<VarDeclaration Name="WCET" Type="TIME" Comment="Worst-case execution time of the entire event chain triggered by EO (not just this block); used for EO thread priority calculation"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="CV" Type="UINT" Comment="Current EO event index (0 to N-1)"/>
		</OutputVars>
	</InterfaceList>
	<FBNetwork>
		<FB Name="RT_E_CYCLE" Type="eclipse4diac::rtevents::RT_E_CYCLE" x="1140" y="665">
		</FB>
		<FB Name="E_CTU" Type="iec61499::events::E_CTU" x="2470" y="1140">
		</FB>
		<FB Name="E_SWITCH" Type="iec61499::events::E_SWITCH" x="3895" y="950">
		</FB>
		<EventConnections>
			<Connection Source="RT_E_CYCLE.EO" Destination="E_CTU.CU" dx1="286.67"/>
			<Connection Source="START" Destination="E_CTU.R" dx1="1855"/>
			<Connection Source="STOP" Destination="RT_E_CYCLE.STOP" dx1="535"/>
			<Connection Source="E_CTU.RO" Destination="RT_E_CYCLE.START" dx1="80" dx2="80" dy="-286.67"/>
			<Connection Source="E_CTU.CUO" Destination="E_SWITCH.EI" dx1="770"/>
			<Connection Source="E_SWITCH.EO0" Destination="EO" dx1="2960"/>
			<Connection Source="E_SWITCH.EO1" Destination="RT_E_CYCLE.STOP" dx1="345" dx2="-285" dy="-715"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="DT" Destination="RT_E_CYCLE.DT" dx1="355"/>
			<Connection Source="Deadline" Destination="RT_E_CYCLE.Deadline" dx1="250"/>
			<Connection Source="WCET" Destination="RT_E_CYCLE.WCET" dx1="175"/>
			<Connection Source="N" Destination="E_CTU.PV" dx1="135"/>
			<Connection Source="E_CTU.CV" Destination="CV" dx1="2300"/>
			<Connection Source="E_CTU.Q" Destination="E_SWITCH.G" dx1="446.67"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
