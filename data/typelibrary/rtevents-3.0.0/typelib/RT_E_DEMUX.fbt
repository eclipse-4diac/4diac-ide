<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="RT_E_DEMUX" Comment="Event demultiplexer">
	<Identification Description="Copyright (c) 2008 ACIN&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0&#10;&#10;Routes EI to one of four output branches (EO0-EO3) selected by index K. Each output branch runs in its own dedicated RT thread with individual Deadline/WCET parameters. Use only when real-time scheduling of the output event chains is required.">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="3.1" Author="Franz Höpfinger" Date="2026-05-14" Remarks="Extended Documentation">
	</VersionInfo>
	<VersionInfo Version="3.0" Author="Patrick Aigner" Date="2025-04-14" Remarks="changed package">
	</VersionInfo>
	<VersionInfo Organization="ACIN" Version="1.0" Author="Alois Zoitl" Date="2008-07-10">
	</VersionInfo>
	<CompilerInfo packageName="eclipse4diac::rtevents">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="Event" Comment="Initialize RT block: QI=TRUE activates with the given timing parameters, QI=FALSE deactivates">
				<With Var="QI"/>
				<With Var="Tmin"/>
				<With Var="Deadline0"/>
				<With Var="WCET0"/>
				<With Var="Deadline1"/>
				<With Var="WCET1"/>
				<With Var="Deadline2"/>
				<With Var="WCET2"/>
				<With Var="Deadline3"/>
				<With Var="WCET3"/>
			</Event>
			<Event Name="EI" Type="Event" Comment="Trigger: routes to EO[K] in its dedicated RT thread; K must be in range 0-3">
				<With Var="K"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="Event" Comment="Initialization confirmation; QO mirrors QI">
				<With Var="QO"/>
			</Event>
			<Event Name="EO0" Type="Event" Comment="Output branch 0: fired in a dedicated RT thread when EI arrives and K=0">
			</Event>
			<Event Name="EO1" Type="Event" Comment="Output branch 1: fired in a dedicated RT thread when EI arrives and K=1">
			</Event>
			<Event Name="EO2" Type="Event" Comment="Output branch 2: fired in a dedicated RT thread when EI arrives and K=2">
			</Event>
			<Event Name="EO3" Type="Event" Comment="Output branch 3: fired in a dedicated RT thread when EI arrives and K=3">
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Enable input: TRUE activates the RT block"/>
			<VarDeclaration Name="K" Type="UINT" Comment="Output selector: index of the output branch to fire (0-3)"/>
			<VarDeclaration Name="Tmin" Type="TIME" Comment="Minimum inter-arrival time between EI events; shared basis for all EO thread priority calculations"/>
			<VarDeclaration Name="Deadline0" Type="TIME" Comment="Relative deadline for the EO0 event chain (must be greater than WCET0)"/>
			<VarDeclaration Name="WCET0" Type="TIME" Comment="Worst-case execution time of the entire event chain triggered by EO0; used for EO0 thread priority calculation"/>
			<VarDeclaration Name="Deadline1" Type="TIME" Comment="Relative deadline for the EO1 event chain (must be greater than WCET1)"/>
			<VarDeclaration Name="WCET1" Type="TIME" Comment="Worst-case execution time of the entire event chain triggered by EO1; used for EO1 thread priority calculation"/>
			<VarDeclaration Name="Deadline2" Type="TIME" Comment="Relative deadline for the EO2 event chain (must be greater than WCET2)"/>
			<VarDeclaration Name="WCET2" Type="TIME" Comment="Worst-case execution time of the entire event chain triggered by EO2; used for EO2 thread priority calculation"/>
			<VarDeclaration Name="Deadline3" Type="TIME" Comment="Relative deadline for the EO3 event chain (must be greater than WCET3)"/>
			<VarDeclaration Name="WCET3" Type="TIME" Comment="Worst-case execution time of the entire event chain triggered by EO3; used for EO3 thread priority calculation"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Enable output: mirrors QI after INIT"/>
		</OutputVars>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
