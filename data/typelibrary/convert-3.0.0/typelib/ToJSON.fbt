<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ToJSON" Comment="Encode JSON string">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Thomas Mayr&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0&#10;&#10;&#10;Adds a field to the JSONIn string. If JSONIn is empty, a new JSON object is created with the specified field.">
	</Identification>
	<VersionInfo Version="1.0" Author="Thomas Mayr" Date="2026-05-16">
	</VersionInfo>
	<CompilerInfo packageName="eclipse4diac::convert">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event" Comment="Execute">
				<With Var="JSONIn"/>
				<With Var="Value"/>
				<With Var="FieldName"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event" Comment="Execution done">
				<With Var="JSONOut"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="JSONIn" Type="STRING" Comment="Input JSON string"/>
			<VarDeclaration Name="Value" Type="ANY" Comment="Value to store"/>
			<VarDeclaration Name="FieldName" Type="STRING" Comment="Key for the value"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="JSONOut" Type="STRING" Comment="Updated JSON string"/>
		</OutputVars>
	</InterfaceList>
	<Service RightInterface="RESOURCE" LeftInterface="APPLICATION">
	</Service>
	<Attribute Name="eclipse4diac::core::TypeHash" Value=""/>
</FBType>
