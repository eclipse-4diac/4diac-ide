<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ReadJSON" Comment="Decode JSON string">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Thomas Mayr&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Version="1.0" Author="Thomas Mayr" Date="2026-05-16">
	</VersionInfo>
	<CompilerInfo packageName="eclipse4diac::convert">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event" Comment="Execute">
				<With Var="JSONIn"/>
				<With Var="FieldName"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event" Comment="Execution done">
				<With Var="Value"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="JSONIn" Type="STRING" Comment="Input JSON string"/>
			<VarDeclaration Name="FieldName" Type="STRING" Comment="Field to extract"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="Value" Type="ANY" Comment="Extracted field value"/>
		</OutputVars>
	</InterfaceList>
	<Service RightInterface="RESOURCE" LeftInterface="APPLICATION">
	</Service>
	<Attribute Name="eclipse4diac::core::TypeHash" Value=""/>
</FBType>
