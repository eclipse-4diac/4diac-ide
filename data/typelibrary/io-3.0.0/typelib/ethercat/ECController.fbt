<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ECController" Comment="EtherCAT master configuration function block">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Sichuan Qunyuan Technology Co., Ltd.&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Version="1.0" Author="Zijun Tang" Date="2026-04-09">
	</VersionInfo>
	<CompilerInfo packageName="eclipse4diac::io::ethercat">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="Event" Comment="Initialize the EtherCAT master">
				<With Var="ControllerIndex"/>
				<With Var="UpdateInterval"/>
				<With Var="QI"/>
			</Event>
			<Event Name="REQ" Type="Event" Comment="Enable or disable cyclic process-data exchange">
				<With Var="Enable"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="Event" Comment="Initialization confirm">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
			<Event Name="CNF" Type="Event" Comment="Confirmation of the requested enable/disable">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
			<Event Name="IND" Type="Event" Comment="Indication of a master or bus state change">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Event input qualifier"/>
			<VarDeclaration Name="Enable" Type="BOOL" Comment="TRUE starts cyclic EtherCAT I/O"/>
			<VarDeclaration Name="ControllerIndex" Type="UINT" Comment="IgH EtherCAT master index"/>
			<VarDeclaration Name="UpdateInterval" Type="TIME" InitialValue="T#30us" Comment="Cyclic task period"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Event output qualifier"/>
			<VarDeclaration Name="STATUS" Type="WSTRING" Comment="Master status"/>
		</OutputVars>
		<Plugs>
			<AdapterDeclaration Name="BusAdapterOut" Type="eclipse4diac::io::ethercat::ECBusAdapter" Comment="Downstream EtherCAT bus adapter"/>
		</Plugs>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
