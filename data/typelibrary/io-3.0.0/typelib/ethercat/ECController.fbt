<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ECController" Comment="Service Interface Function Block Type">
	<Identification Standard="61499-2">
	</Identification>
	<VersionInfo Version="1.0" Author="hyperion" Date="2026-04-09">
	</VersionInfo>
	<CompilerInfo packageName="eclipse4diac::io::ethercat">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="Event" Comment="Service Initialization">
				<With Var="ControllerIndex"/>
				<With Var="UpdateInterval"/>
				<With Var="QI"/>
			</Event>
			<Event Name="REQ" Type="Event">
				<With Var="Enable"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="Event" Comment="Initialization Confirm">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
			<Event Name="CNF" Type="Event" Comment="Confirmation of Requested Service">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
			<Event Name="IND" Type="Event" Comment="Indication from Resource">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL"/>
			<VarDeclaration Name="Enable" Type="BOOL"/>
			<VarDeclaration Name="ControllerIndex" Type="UINT"/>
			<VarDeclaration Name="UpdateInterval" Type="TIME" InitialValue="T#30us"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Event Output Qualifier"/>
			<VarDeclaration Name="STATUS" Type="WSTRING" Comment="Service Status"/>
		</OutputVars>
		<Plugs>
			<AdapterDeclaration Name="BusAdapterOut" Type="eclipse4diac::io::ethercat::ECBusAdapter"/>
		</Plugs>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
