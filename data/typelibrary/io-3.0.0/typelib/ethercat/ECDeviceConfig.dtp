	</Identification>
	<VersionInfo Version="1.0" Author="Zijun Tang" Date="2026-04-10">
	</VersionInfo>
	<CompilerInfo packageName="eclipse4diac::io::ethercat">
	</CompilerInfo>
	<StructuredType>
		<VarDeclaration Name="Alias" Type="UINT" Comment="Configured station alias"/>
		<VarDeclaration Name="Position" Type="UINT" Comment="Auto-increment position on the EtherCAT ring"/>
		<VarDeclaration Name="VendorId" Type="UDINT" Comment="EtherCAT vendor ID"/>
		<VarDeclaration Name="ProductCode" Type="UDINT" Comment="ESI Type/@ProductCode"/>
	</StructuredType>
</DataType>
