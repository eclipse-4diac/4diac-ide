<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ST_SET_PARM" Comment="Sets the parameter to a data input of a FB, Resource or Device instance">
	<Identification Standard="61499-1" Classification="Reconfiguration" Function="Sets Parameter" Type="Structural Service" Description="Copyright (c) 2012 Profactor GmbH&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Profactor GmbH" Version="1.0" Author="Gerhard Ebenhofer" Date="2012-05-31">
	</VersionInfo>
	<VersionInfo Version="3.0" Author="Patrick Aigner" Date="2025-04-14" Remarks="changed package">
	</VersionInfo>
	<CompilerInfo packageName="eclipse4diac::reconfiguration">
		<Compiler Language="Cpp" Vendor="GNU" Product="GCC" Version="&gt;3.0"/>
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event" Comment="Event to require setting a parameter">
				<With Var="ELEM_NAME"/>
				<With Var="ELEM_DATA_IN"/>
				<With Var="PARM_VAL"/>
				<With Var="DST"/>
				<With Var="QI"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event" Comment="Event to confirm that the parameter has been set">
				<With Var="STATUS"/>
				<With Var="QO"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Event Input Qualifier"/>
			<VarDeclaration Name="ELEM_NAME" Type="WSTRING" Comment="Reference to element instance"/>
			<VarDeclaration Name="ELEM_DATA_IN" Type="WSTRING" Comment="Reference to data input"/>
			<VarDeclaration Name="PARM_VAL" Type="WSTRING" Comment="Parameter value"/>
			<VarDeclaration Name="DST" Type="WSTRING" Comment="Destination where the parameter has to be set (Syntax: ResourceName)"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Event Output Qualifier"/>
			<VarDeclaration Name="STATUS" Type="WSTRING" Comment="Service Status: RDY, NO_SUCH_OBJECT, INVALID_STATE"/>
		</OutputVars>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
