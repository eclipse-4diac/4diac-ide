<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ST_CREATE_CONN" Comment="Creates an event or data connection between two FB instances">
	<Identification Standard="61499-1" Classification="Reconfiguration" Function="Creates Connection" Type="Structural Service" Description="Copyright (c) 2012 Profactor GmbH&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Version="3.0" Author="Patrick Aigner" Date="2025-04-14" Remarks="changed package">
	</VersionInfo>
	<VersionInfo Organization="Profactor GmbH" Version="1.0" Author="Gerhard Ebenhofer" Date="2012-05-31">
	</VersionInfo>
	<CompilerInfo packageName="eclipse4diac::reconfiguration">
		<Compiler Language="Cpp" Vendor="GNU" Product="GCC" Version="&gt;3.0"/>
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event" Comment="Event to require creation of a connection">
				<With Var="SRC_FB"/>
				<With Var="SRC_FB_OUT"/>
				<With Var="DST_FB"/>
				<With Var="DST_FB_IN"/>
				<With Var="DST"/>
				<With Var="QI"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event" Comment="Event to confirm that the connection has been created">
				<With Var="STATUS"/>
				<With Var="QO"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Event Input Qualifier"/>
			<VarDeclaration Name="SRC_FB" Type="WSTRING" Comment="Reference to Source FB instance"/>
			<VarDeclaration Name="SRC_FB_OUT" Type="WSTRING" Comment="Reference to Source FB instance Event/Data-Output"/>
			<VarDeclaration Name="DST_FB" Type="WSTRING" Comment="Reference to Destination FB instance"/>
			<VarDeclaration Name="DST_FB_IN" Type="WSTRING" Comment="Reference to Destination FB instance Event/Data-Input"/>
			<VarDeclaration Name="DST" Type="WSTRING" Comment="Destination where the connection has to be created (Syntax: ResourceName)"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Event Output Qualifier"/>
			<VarDeclaration Name="STATUS" Type="WSTRING" Comment="Service Status: RDY, NO_SUCH_OBJECT, INVALID_STATE"/>
		</OutputVars>
	</InterfaceList>
	<Service RightInterface="RESOURCE" LeftInterface="APPLICATION" Comment="Creates an event or data connection between two FB instances">
		<ServiceSequence Name="normal_establishment">
			<ServiceTransaction>
				<InputPrimitive Interface="APPLICATION" Event="INIT+"/>
				<OutputPrimitive Interface="APPLICATION" Event="INITO+"/>
			</ServiceTransaction>
		</ServiceSequence>
		<ServiceSequence Name="unsuccessful_establishment">
			<ServiceTransaction>
				<InputPrimitive Interface="APPLICATION" Event="INIT+"/>
				<OutputPrimitive Interface="APPLICATION" Event="INITO-"/>
			</ServiceTransaction>
		</ServiceSequence>
		<ServiceSequence Name="request_confirm">
			<ServiceTransaction>
				<InputPrimitive Interface="APPLICATION" Event="REQ+"/>
				<OutputPrimitive Interface="APPLICATION" Event="CNF+"/>
			</ServiceTransaction>
		</ServiceSequence>
		<ServiceSequence Name="request_inhibited">
			<ServiceTransaction>
				<InputPrimitive Interface="APPLICATION" Event="REQ-"/>
				<OutputPrimitive Interface="APPLICATION" Event="CNF-"/>
			</ServiceTransaction>
		</ServiceSequence>
		<ServiceSequence Name="request_error">
			<ServiceTransaction>
				<InputPrimitive Interface="APPLICATION" Event="REQ+"/>
				<OutputPrimitive Interface="APPLICATION" Event="CNF-"/>
			</ServiceTransaction>
		</ServiceSequence>
		<ServiceSequence Name="application_initiated_termination">
			<ServiceTransaction>
				<InputPrimitive Interface="APPLICATION" Event="INIT-"/>
				<OutputPrimitive Interface="APPLICATION" Event="INITO-"/>
			</ServiceTransaction>
		</ServiceSequence>
		<ServiceSequence Name="resource_initiated_termination">
			<ServiceTransaction>
				<OutputPrimitive Interface="APPLICATION" Event="INITO-"/>
			</ServiceTransaction>
		</ServiceSequence>
	</Service>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
