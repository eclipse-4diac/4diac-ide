	</VersionInfo>
	<CompilerInfo packageName="iec61131::charString">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event" Comment="Service Request">
				<With Var="IN1"/>
				<With Var="IN2"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event" Comment="Confirmation of Requested Service">
				<With Var="OUT"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="IN1" Type="ANY_STRING" Comment="input string 1"/>
			<VarDeclaration Name="IN2" Type="ANY_STRING" Comment="input string 2"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="OUT" Type="ANY_STRING" Comment="Result"/>
		</OutputVars>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::GenericClassName" Value="'GEN_CONCAT'"/>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
