<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="F_CONCAT_TOD" Comment="concatenation to TIME_OF_DAY">
	<Identification Standard="61131-3" Classification="standard character and string function" Description="Copyright (c) 2013 TU Wien ACIN and others.&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0&#10;&#10;Some portions generated by Gemini CLI">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-01-31" Remarks="F_CONCAT_TOD copied from an existing fB and implemented according IEC 61131-3">
	</VersionInfo>
	<CompilerInfo packageName="iec61131::charString">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event" Comment="Service Request">
				<With Var="HOUR"/>
				<With Var="MINUTE"/>
				<With Var="SECOND"/>
				<With Var="MILLISECOND"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event" Comment="Confirmation of Requested Service">
				<With Var="OUT"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="HOUR" Type="ANY_INT" Comment="Hour"/>
			<VarDeclaration Name="MINUTE" Type="ANY_INT" Comment="Minute"/>
			<VarDeclaration Name="SECOND" Type="ANY_INT" Comment="Second"/>
			<VarDeclaration Name="MILLISECOND" Type="ANY_INT" Comment="Millisecond"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="OUT" Type="TIME_OF_DAY" Comment="Resulting TIME_OF_DAY"/>
		</OutputVars>
	</InterfaceList>
	<SimpleFB>
		<ECState Name="REQ">
			<ECAction Algorithm="REQ" Output="CNF"/>
		</ECState>
		<Algorithm Name="REQ">
			<ST><![CDATA[
ALGORITHM REQ
OUT := CONCAT_TOD(HOUR, MINUTE, SECOND, MILLISECOND);
END_ALGORITHM

]]></ST>
		</Algorithm>
	</SimpleFB>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
