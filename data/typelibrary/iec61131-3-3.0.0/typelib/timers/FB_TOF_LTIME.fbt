<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="FB_TOF_LTIME" Comment="standard timer function block (off-delay timing) (LTIME)">
	<Identification Standard="61131-3" Classification="standard timer function block" Description="Copyright (c) 2011 TU Wien ACIN, Patrick Aigner, HR Agrartechnik GmbH&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0&#10;&#10;Some portions generated by Gemini CLI">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-02-01" Remarks="Copy over from FB_TOF and made this Block">
	</VersionInfo>
	<CompilerInfo packageName="iec61131::timers">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event" Comment="Normal Execution Request">
				<With Var="IN"/>
				<With Var="PT"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event" Comment="Execution Confirmation">
				<With Var="Q"/>
				<With Var="ET"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="IN" Type="BOOL" Comment="Input"/>
			<VarDeclaration Name="PT" Type="LTIME" Comment="Process time"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="Q" Type="BOOL" Comment="Output"/>
			<VarDeclaration Name="ET" Type="LTIME" Comment="Elapsed time"/>
		</OutputVars>
	</InterfaceList>
	<SimpleFB>
		<InternalVars>
			<VarDeclaration Name="MEM" Type="BOOL" Comment="internal variable"/>
			<VarDeclaration Name="StartTime" Type="LTIME" Comment="internal variable"/>
		</InternalVars>
		<ECState Name="REQ">
			<ECAction Algorithm="REQ" Output="CNF"/>
		</ECState>
		<Algorithm Name="REQ">
			<ST><![CDATA[ALGORITHM REQ

VAR_TEMP
	SysTime : TIME;
END_VAR

SysTime := NOW_MONOTONIC();

IF IN THEN
	Q := TRUE;
	ET := LT#0s;
	MEM := FALSE;

ELSIF Q THEN
	IF NOT MEM THEN
		StartTime := SysTime;
		MEM := TRUE;
	END_IF;

	ET := SysTime - StartTime;

	IF ET >= PT THEN
		Q := FALSE;
		ET := PT;
	END_IF;
END_IF;
END_ALGORITHM

]]></ST>
		</Algorithm>
	</SimpleFB>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
