<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="OUT_ANY_CONSOLE" Comment="Service Interface Function Block Type for debugging, tracing, etc.">
	<Identification Description="Copyright (c) 2011 Profactor GmbH&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Version="3.0" Author="Patrick Aigner" Date="2025-04-14" Remarks="changed package">
	</VersionInfo>
	<VersionInfo Organization="Profactor GmbH" Version="1.0" Author="Thomas Strasser" Date="2011-08-29">
	</VersionInfo>
	<CompilerInfo packageName="eclipse4diac::utils">
		<Compiler Language="Cpp" Vendor="Unknown" Product="Unknown" Version="1.0"/>
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event" Comment="Service Request">
				<With Var="QI"/>
				<With Var="IN"/>
				<With Var="LABEL"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event" Comment="Confirmation of Requested Service">
				<With Var="QO"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Event Input Qualifier"/>
			<VarDeclaration Name="LABEL" Type="STRING" Comment="Label for the output value"/>
			<VarDeclaration Name="IN" Type="ANY" Comment="Output value to console"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Event Output Qualifier"/>
		</OutputVars>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
