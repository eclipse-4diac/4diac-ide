	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-02-01" Remarks="Initial creation based on E_SWITCH and E_SPLIT_3">
	</VersionInfo>
	<CompilerInfo packageName="iec61499::events">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="EI0" Type="Event" Comment="Channel 0: Event Input">
				<With Var="G"/>
			</Event>
			<Event Name="EI1" Type="Event" Comment="Channel 1: Event Input">
				<With Var="G"/>
			</Event>
			<Event Name="EI2" Type="Event" Comment="Channel 2: Event Input">
				<With Var="G"/>
			</Event>
			<Event Name="EI3" Type="Event" Comment="Channel 3: Event Input">
				<With Var="G"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="EO0_0" Type="Event" Comment="Channel 0: Output, switched from EI0 when G=0">
			</Event>
			<Event Name="EO0_1" Type="Event" Comment="Channel 0: Output, switched from EI0 when G=1">
			</Event>
			<Event Name="EO1_0" Type="Event" Comment="Channel 1: Output, switched from EI1 when G=0">
			</Event>
			<Event Name="EO1_1" Type="Event" Comment="Channel 1: Output, switched from EI1 when G=1">
			</Event>
			<Event Name="EO2_0" Type="Event" Comment="Channel 2: Output, switched from EI2 when G=0">
			</Event>
			<Event Name="EO2_1" Type="Event" Comment="Channel 2: Output, switched from EI2 when G=1">
			</Event>
			<Event Name="EO3_0" Type="Event" Comment="Channel 3: Output, switched from EI3 when G=0">
			</Event>
			<Event Name="EO3_1" Type="Event" Comment="Channel 3: Output, switched from EI3 when G=1">
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="G" Type="BOOL" Comment="Channel 0-3: Switch EIn to EOn_0 when G=0, EIn to to EOn_1 when G=1"/>
		</InputVars>
