<FBType Name="E_SWITCH_4" Comment="Switching (demultiplexing) an event based on boolean input G (4 channels, generic FB)">
	<Identification Standard="61499-1 Annex A" Classification="event function block" Function="Switching events (4 channels)" Description="Copyright (c) 2017, 2026 fortiss GmbH, HR Agrartechnik GmbH&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0&#10;&#10;Some portions generated by Gemini CLI">
