<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="E_F_TRIG" Comment="Boolean falling edge detection">
	<Identification Standard="61499-1 Annex A" Description="Copyright (c) 2017 fortiss GmbH&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Version="3.0" Author="Patrick Aigner" Date="2025-04-14" Remarks="changed package">
	</VersionInfo>
	<VersionInfo Organization="fortiss GmbH" Version="1.0" Author="Alois Zoitl" Date="2017-09-22" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="iec61499::events">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="EI" Type="Event" Comment="check for falling edge">
				<With Var="QI"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="EO" Type="Event" Comment="confirmation that a falling edge was detected">
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="value to check for a falling edge"/>
		</InputVars>
	</InterfaceList>
	<FBNetwork>
		<FB Name="E_D_FF" Type="iec61499::events::E_D_FF" x="780" y="100">
		</FB>
		<FB Name="E_SWITCH" Type="iec61499::events::E_SWITCH" x="1400" y="100">
		</FB>
		<EventConnections>
			<Connection Source="EI" Destination="E_D_FF.CLK" dx1="560"/>
			<Connection Source="E_D_FF.EO" Destination="E_SWITCH.EI" dx1="80" dx2="80" dy="160"/>
			<Connection Source="E_SWITCH.EO0" Destination="EO" dx1="4533.33"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="QI" Destination="E_D_FF.D" dx1="80" dx2="80" dy="-86.67"/>
			<Connection Source="E_D_FF.Q" Destination="E_SWITCH.G" dx1="80" dx2="80" dy="160"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
