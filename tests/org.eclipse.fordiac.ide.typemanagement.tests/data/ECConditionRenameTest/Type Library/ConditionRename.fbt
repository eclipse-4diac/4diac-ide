<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ConditionRename" Comment="">
	<Identification Standard="61499-1" Description="Copyright (c) 2026 Martin Erich Jobst&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Version="1.0" Author="Martin Jobst" Date="2026-11-18">
	</VersionInfo>
	<CompilerInfo>
		<Import declaration="conditionrename::constants::ConditionConstants::*"/>
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="EI" Type="Event"/>
		</EventInputs>
		<InputVars>
			<VarDeclaration Name="Enabled" Type="BOOL"/>
			<VarDeclaration Name="Other" Type="BOOL"/>
			<VarDeclaration Name="Data" Type="ConditionData"/>
		</InputVars>
	</InterfaceList>
	<BasicFB>
		<ECC>
			<ECState Name="START" x="0.0" y="0.0"/>
			<ECState Name="DONE" x="100.0" y="100.0"/>
			<ECTransition Source="START" Destination="DONE" Condition="EI [Available AND Enabled AND Other]"/>
			<ECTransition Source="DONE" Destination="START" Condition="EI [NOT enabled]"/>
			<ECTransition Source="START" Destination="DONE" Condition="EI [Data.Flag AND Other]"/>
			<ECTransition Source="DONE" Destination="START" Condition="EI"/>
			<ECTransition Source="START" Destination="DONE" Condition="EI [Missing]"/>
			<ECTransition Source="DONE" Destination="START" Condition="EI [conditionrename::constants::ConditionConstants::Enabled]"/>
		</ECC>
	</BasicFB>
</FBType>
