	</Identification>
	<VersionInfo Version="1.0" Author="Martin Jobst" Date="2026-10-28">
	</VersionInfo>
	<CompilerInfo>
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event" Comment="Request">
				<With Var="DI1"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event" Comment="Confirmation">
				<With Var="DO1"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="DI1" Type="DINT" InitialValue="DINT#42"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="DO1" Type="DINT"/>
		</OutputVars>
	</InterfaceList>
	<FBNetwork>
		<FB Name="Basic" Type="BasicHashTest" x="100" y="100">
		</FB>
		<EventConnections>
			<Connection Source="REQ" Destination="Basic.REQ"/>
			<Connection Source="Basic.CNF" Destination="CNF"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="DI1" Destination="Basic.DI1"/>
			<Connection Source="Basic.DO1" Destination="DO1"/>
		</DataConnections>
	</FBNetwork>
