	</Identification>
	<VersionInfo Version="1.0" Author="Martin Jobst" Date="2026-10-23">
	</VersionInfo>
	<CompilerInfo>
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event" Comment="Request">
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event" Comment="Confirmation">
			</Event>
		</EventOutputs>
	</InterfaceList>
	<Service RightInterface="SOCKET" LeftInterface="PLUG" Comment="Request-confirmation service">
		<ServiceSequence Name="request_confirm">
			<Attribute Name="StartState" Type="STRING" Value="REQ"/>
			<Attribute Name="ServiceSequenceType" Type="STRING" Value="ALWAYS"/>
			<ServiceTransaction>
				<InputPrimitive Interface="SOCKET" Event="REQ" Parameters=""/>
				<OutputPrimitive Interface="PLUG" Event="REQ" Parameters=""/>
			</ServiceTransaction>
			<ServiceTransaction>
				<InputPrimitive Interface="PLUG" Event="CNF" Parameters=""/>
				<OutputPrimitive Interface="SOCKET" Event="CNF" Parameters=""/>
			</ServiceTransaction>
		</ServiceSequence>
	</Service>
</FBType>
