<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="BasicTest" Comment="Basic FB with an ECC">
	<Identification Standard="61499-1" Classification="Fixture" ApplicationDomain="Testing" Function="Exercise import/export" Type="Basic FB" Description="Fixture for importer and exporter coverage">
	</Identification>
	<VersionInfo Organization="Eclipse" Version="1.0" Author="mjobst" Date="2026-10-23" Remarks="Canonical fixture">
	</VersionInfo>
	<CompilerInfo header="basic.h" classdef="BasicTest" packageName="fixture::basic">
		<Import declaration="fixture"/>
		<Compiler Language="C" Vendor="Eclipse" Product="4diac" Version="1.0"/>
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event" Comment="Request">
				<With Var="DI1"/>
				<With Var="STATE"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event" Comment="Confirmation">
				<With Var="DO1"/>
				<With Var="STATE"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="DI1" Type="DINT" InitialValue="DINT#1">
				<Attribute Name="IntegerAttribute" Value="1"/>
				<Attribute Name="StructuredAttribute" Value="(7,TRUE,'fixture')"/>
			</VarDeclaration>
			<VarDeclaration Name="Samples" Type="DINT" ArraySize="4"/>
			<VarDeclaration Name="Settings" Type="structtype"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="DO1" Type="BOOL"/>
		</OutputVars>
		<Plugs>
			<AdapterDeclaration Name="EVENT" Type="EventAdapter" Comment="Event/data adapter">
				<Parameter Name="REQD" Value="WSTRING#'request'"/>
			</AdapterDeclaration>
		</Plugs>
		<InOutVars>
			<VarDeclaration Name="STATE" Type="DINT" InitialValue="DINT#0"/>
		</InOutVars>
	</InterfaceList>
	<BasicFB>
		<InternalVars>
			<VarDeclaration Name="counter" Type="DINT" InitialValue="DINT#0"/>
			<FB Name="helper" Type="SimpleTest" Comment="Internal helper">
			</FB>
		</InternalVars>
		<InternalConstVars>
			<VarDeclaration Name="limit" Type="DINT" InitialValue="DINT#10"/>
		</InternalConstVars>
		<ECC>
			<ECState Name="START" Comment="Initial State" x="0" y="0">
			</ECState>
			<ECState Name="RUN" x="100" y="0">
				<ECAction Algorithm="RUN" Output="CNF"/>
			</ECState>
			<ECTransition Source="START" Destination="RUN" Condition="REQ" x="50" y="0"/>
			<ECTransition Source="RUN" Destination="START" Condition="1" x="50" y="50"/>
		</ECC>
		<Algorithm Name="RUN">
			<ST><![CDATA[ALGORITHM RUN
	DO1 := DI1 > 0;
END_ALGORITHM
]]></ST>
		</Algorithm>
		<Algorithm Name="SCRIPT">
			<Other Language="Lua"><![CDATA[emit("fixture")]]></Other>
		</Algorithm>
		<Method Name="Compute" Type="DINT" Comment="Computes a value">
			<ST><![CDATA[Compute := operand + offset;]]></ST>
			<InputVars>
				<VarDeclaration Name="operand" Type="DINT"/>
			</InputVars>
			<OutputVars>
				<VarDeclaration Name="offset" Type="DINT"/>
			</OutputVars>
		</Method>
		<Method Name="ScriptMethod" Type="DINT">
			<Other Language="Lua"><![CDATA[return operand]]></Other>
			<InputVars>
				<VarDeclaration Name="operand" Type="DINT"/>
			</InputVars>
			<OutputVars>
				<VarDeclaration Name="result" Type="DINT"/>
			</OutputVars>
		</Method>
	</BasicFB>
</FBType>
