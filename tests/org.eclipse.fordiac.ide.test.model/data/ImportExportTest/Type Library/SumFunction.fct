<?xml version="1.0" encoding="UTF-8"?>
<Function Name="SumFunction" Comment="Adds two input values">
	<Identification Standard="61499-1" Description="Copyright (c) 2026 Martin Erich Jobst&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Version="1.0" Author="Martin Jobst" Date="2026-10-23">
	</VersionInfo>
	<CompilerInfo>
	</CompilerInfo>
	<InterfaceList>
		<InputVars>
			<VarDeclaration Name="IN1" Type="DINT"/>
			<VarDeclaration Name="IN2" Type="DINT"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="OUT" Type="DINT"/>
		</OutputVars>
	</InterfaceList>
	<FunctionBody>
		<ST><![CDATA[OUT := IN1 + IN2;]]></ST>
	</FunctionBody>
	<Attribute Name="IntegerAttribute" Value="9"/>
</Function>
