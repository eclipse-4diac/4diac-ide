<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="SimpleTest" Comment="Simple FB with one algorithm">
	<Identification Standard="61499-1">
	</Identification>
	<VersionInfo Version="1.0" Author="mjobst" Date="2026-10-20">
	</VersionInfo>
	<CompilerInfo>
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event" Comment="Normal Execution Request">
			</Event>
			<Event Name="ALT" Type="Event" Comment="Alternate Execution Request">
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event" Comment="Execution Confirmation">
				<Attribute Name="IntegerAttribute" Value="5"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="DI1" Type="DINT"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="DO1" Type="BOOL"/>
		</OutputVars>
	</InterfaceList>
	<SimpleFB>
		<ECState Name="REQ">
			<ECAction Algorithm="REQ" Output="CNF"/>
		</ECState>
		<ECState Name="ALT">
			<ECAction Algorithm="ALT" Output="CNF"/>
		</ECState>
		<Algorithm Name="REQ">
			<ST><![CDATA[
]]></ST>
		</Algorithm>
		<Algorithm Name="ALT">
			<ST><![CDATA[
]]></ST>
		</Algorithm>
	</SimpleFB>
	<Attribute Name="IntegerAttribute" Value="6"/>
</FBType>
