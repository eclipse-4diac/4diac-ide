			<Event Name="REQ1" Type="Event"/>
			<Event Name="REQ2" Type="Event"/>
		</EventInputs>
	</InterfaceList>
	<FBNetwork>
		<FB Name="MissingDataType" Type="iec61131::selection::F_MOVE" x="0" y="0">
