	<CompilerInfo packageName="lib::VarDeclaration::support"/>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event" Comment="Normal Execution Request">
				<With Var="Input"/>
				<With Var="IO"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event" Comment="Execution Confirmation">
				<With Var="IO"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="Input" Type="ANY"/>
		</InputVars>
		<InOutVars>
			<VarDeclaration Name="IO" Type="ANY"/>
		</InOutVars>
	</InterfaceList>
</FBType>