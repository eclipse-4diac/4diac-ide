	</Identification>
	<VersionInfo Version="1.0" Author="Martin Jobst" Date="2026-11-18">
	</VersionInfo>
	<CompilerInfo packageName="lib::Event"/>
	<InterfaceList>
		<EventInputs>
			<Event Name="IN" Type="Event"/>
		</EventInputs>
		<EventOutputs>
			<Event Name="OUT1" Type="Event"/>
			<Event Name="OUT2" Type="Event"/>
		</EventOutputs>
	</InterfaceList>
	<FBNetwork>
		<EventConnections>
			<Connection Source="IN" Destination="OUT1"/>
			<Connection Source="IN" Destination="OUT2"/>
		</EventConnections>
	</FBNetwork>
</FBType>