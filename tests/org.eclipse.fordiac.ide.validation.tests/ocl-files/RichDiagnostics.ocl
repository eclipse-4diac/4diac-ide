import 'platform:/resource/org.eclipse.fordiac.ide.model/model/lib.ecore'

package libraryElement

context BaseFBType
inv RichError:
	Tuple {
		status = self.name = 'valid',
		message = 'Invalid BaseFBType: ' + self.name,
		severity = -1,
		markerTarget = self
	}.status

inv RichWarningContext:
	Tuple {
		status = false,
		message = 'Context warning',
		severity = 1,
		markerTarget = 'context'
	}.status

inv RichOkSeverity:
	Tuple {
		status = false,
		message = 'No marker',
		severity = 0
	}.status

inv RichDefaults:
	Tuple {
		status = false
	}.status

inv InvalidMarkerTarget:
	Tuple {
		status = false,
		message = 'Invalid marker target',
		severity = -1,
		markerTarget = 42
	}.status

inv _'ERROR;[SelfCycleMustBeGatedByEvent]':
	self.name = 'valid'

endpackage
