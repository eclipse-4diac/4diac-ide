import 'platform:/resource/org.eclipse.fordiac.ide.model/model/lib.ecore'
import 'platform:/resource/org.eclipse.fordiac.ide.model/model/data.ecore'

context data::StructuredType
inv MultipleImports:
	let usedByConfigurableFB : Boolean =
		libraryElement::ConfigurableFB.allInstances()
			->exists(fb | fb.dataType = self)
	in
	let hasBlockAttribute : Boolean =
		self.attributes
			->exists(a | a.name = 'xx::yy::zz::block')
	in
	Tuple {
		status = not usedByConfigurableFB or hasBlockAttribute,
		message = 'Used DataType needs attribute xx::yy::zz::block',
		severity = -1,
		markerTarget = self
	}.status
