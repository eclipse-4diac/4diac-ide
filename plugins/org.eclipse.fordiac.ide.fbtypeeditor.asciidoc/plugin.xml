        icon="icons/admonition_important.svg"
        label="%toolbar.admonition.important.label"
        style="push">
        <parameter name="org.eclipse.fordiac.ide.fbtypeeditor.asciidoc.commands.template.name" value="IMPORTANT" />
      </command>
      <command
