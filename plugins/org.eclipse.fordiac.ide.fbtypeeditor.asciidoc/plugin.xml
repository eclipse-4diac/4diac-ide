      </command>
      <command
        commandId="org.eclipse.fordiac.ide.fbtypeeditor.asciidoc.commands.applyTemplate"
        icon="icons/admonition_warning.svg"
        label="%toolbar.admonition.warning.label"
        style="push">
        <parameter name="org.eclipse.fordiac.ide.fbtypeeditor.asciidoc.commands.template.name" value="WARNING" />
      </command>
      <separator
        name="org.eclipse.fordiac.ide.fbtypeeditor.asciidoc.toolbar.admonition.separator"
        visible="true" 
      />
      <command
        commandId="org.eclipse.fordiac.ide.fbtypeeditor.asciidoc.commands.applyTemplate"
        icon="icons/admonition_note.svg"
        label="%toolbar.admonition.note.block.label"
        style="push">
        <parameter name="org.eclipse.fordiac.ide.fbtypeeditor.asciidoc.commands.template.name" value="NOTE Block" />
      </command>
      <command
        commandId="org.eclipse.fordiac.ide.fbtypeeditor.asciidoc.commands.applyTemplate"
        icon="icons/admonition_important.svg"
        label="%toolbar.admonition.important.block.label"
        style="push">
        <parameter name="org.eclipse.fordiac.ide.fbtypeeditor.asciidoc.commands.template.name" value="IMPORTANT Block" />
      </command>
      <command
        commandId="org.eclipse.fordiac.ide.fbtypeeditor.asciidoc.commands.applyTemplate"
        icon="icons/admonition_tip.svg"
        label="%toolbar.admonition.tip.block.label"
        style="push">
        <parameter name="org.eclipse.fordiac.ide.fbtypeeditor.asciidoc.commands.template.name" value="TIP Block" />
      </command>
      <command
        commandId="org.eclipse.fordiac.ide.fbtypeeditor.asciidoc.commands.applyTemplate"
        icon="icons/admonition_caution.svg"
        label="%toolbar.admonition.caution.block.label"
        style="push">
        <parameter name="org.eclipse.fordiac.ide.fbtypeeditor.asciidoc.commands.template.name" value="CAUTION Block" />
      </command>
      <command
        commandId="org.eclipse.fordiac.ide.fbtypeeditor.asciidoc.commands.applyTemplate"
        icon="icons/admonition_warning.svg"
        label="%toolbar.admonition.warning.block.label"
        style="push">
        <parameter name="org.eclipse.fordiac.ide.fbtypeeditor.asciidoc.commands.template.name" value="WARNING Block" />
      </command>
    </menuContribution>
  </extension>
  
</plugin>
