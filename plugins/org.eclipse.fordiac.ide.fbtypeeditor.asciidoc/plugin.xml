        icon="icons/admonition_tip.svg"
        label="%toolbar.admonition.tip.label"
        style="push">
        <parameter name="org.eclipse.fordiac.ide.fbtypeeditor.asciidoc.commands.template.name" value="TIP" />
      </command>
      <command
        commandId="org.eclipse.fordiac.ide.fbtypeeditor.asciidoc.commands.applyTemplate"
