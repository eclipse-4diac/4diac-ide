<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
  <extension
      point="org.eclipse.fordiac.ide.typeeditor.typeEditorPage">
    <editorPage
        class="org.eclipse.fordiac.ide.fbtypeeditor.asciidoc.editors.AsciiDocDocumentationEditor"
        sortIndex="1000">
      <enablement>
        <adapt type="org.eclipse.core.resources.IFile">
          <test property="org.eclipse.core.resources.readOnly" value="false"/>
        </adapt>
      </enablement>
    </editorPage>
    <editorPage
        class="org.eclipse.fordiac.ide.fbtypeeditor.asciidoc.editors.AsciiDocPreviewTypeEditorPage"
        sortIndex="1000">
      <enablement>
        <adapt type="org.eclipse.core.resources.IFile">
          <test property="org.eclipse.core.resources.readOnly" value="true"/>
        </adapt>
      </enablement>
    </editorPage>
  </extension>
  <extension point="org.eclipse.mylyn.wikitext.ui.contentAssist">
    <templates markupLanguage="AsciiDoc">

       <template name="fbt" description="%template.fbt.macro" content="fbt:${text}[${param}] $"/>

     </templates>
  </extension>




  <extension point="org.eclipse.ui.commands">
     <command
           id="org.eclipse.fordiac.ide.fbtypeeditor.asciidoc.commands.bold"
           name="Format Bold">
     </command>
  </extension>


  <extension point="org.eclipse.ui.handlers">
     <handler
           class="org.eclipse.fordiac.ide.fbtypeeditor.asciidoc.handlers.BoldFormatHandler"
           commandId="org.eclipse.fordiac.ide.fbtypeeditor.asciidoc.commands.bold">
     </handler>
  </extension>


  <extension point="org.eclipse.ui.menus">
     <menuContribution
           locationURI="toolbar:org.eclipse.fordiac.ide.fbtypeeditor.asciidoc.toolbar">
        <command
              commandId="org.eclipse.fordiac.ide.fbtypeeditor.asciidoc.commands.bold"
              icon="icons/bold.svg"
              label="Bold"
              tooltip="Make selected text bold"
              style="push">
        </command>
     </menuContribution>
  </extension>
  
  
  
</plugin>
